[pendant]
address = "AA:BB:CC:DD:EE:FF"

# Automatic service and `device sync` require one exact-address scanner
# candidate to remain visible for this span before opening GATT.
[presence]
arrival_stability_seconds = 30.0
arrival_max_gap_seconds = 10.0

# Legacy compatibility only. Publication waits for a durable physical-visit
# closure; these values no longer trigger publication by size or age.
[ready]
target_audio_seconds = 3600.0
max_wait_seconds = 86400.0
