pendant_address = "AA:BB:CC:DD:EE:FF" # Bluetooth address printed by `bluetoothctl devices`

# Publish a ready bundle after a complete pendant drain once captured Opus
# audio reaches this cumulative minimum (3600 seconds = 1 hour). This is not
# elapsed wait time or a maximum chunk size; smaller drains accumulate in
# SQLite indefinitely. VAD processing happens downstream and does not set
# this duration.
bundle_min_audio_seconds = 3600.0
