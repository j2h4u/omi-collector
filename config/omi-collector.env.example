# Copy to /etc/omi-collector/omi-collector.env and replace every value. The
# installer sets it to root:omi-collector 0640; use one unquoted KEY=value per line.
OMI_COLLECTOR_DEVICE_ADDRESS=AA:BB:CC:DD:EE:FF
OMI_COLLECTOR_DEVICE_SLUG=replace-me
OMI_COLLECTOR_LAYOUT_PATH=/var/lib/omi-collector/collector.toml
OMI_COLLECTOR_PROJECT_DIR=/opt/omi-collector
OMI_COLLECTOR_UV_BIN=/usr/local/bin/uv
OMI_COLLECTOR_UV_PROJECT_ENVIRONMENT=/var/lib/omi-collector-deployments/uninitialized
