[Unit]
Description=Omi CV1 pendant collector
Requires=bluetooth.service
After=bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=infinity
User=@OMI_COLLECTOR_USER@
Group=@OMI_COLLECTOR_GROUP@
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/local/sbin/omi-collector-bluetooth-ready
ExecStart=@OMI_COLLECTOR_HOME@/.local/share/omi-collector/current/bin/omi-collector service --config /srv/pipelines/omi/config.toml
Restart=always
RestartPreventExitStatus=78
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=5min
TimeoutStopSec=180s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omi-collector
UMask=0027
AmbientCapabilities=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/pipelines/omi
PrivateTmp=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
