[Unit]
Description=Omi CV1 pendant collector
Requires=bluetooth.service
After=bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=omi-collector
Group=omi-collector
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 XDG_STATE_HOME=/var/lib/omi-collector
ExecStartPre=+/usr/local/sbin/omi-collector-bluetooth-ready
ExecStart=/var/lib/omi-collector-deployments/current/bin/omi-collector service --config /srv/pipelines/omi/config.toml
Restart=always
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=5min
TimeoutStopSec=180s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omi-collector
UMask=0027
AmbientCapabilities=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/omi-collector /srv/pipelines/omi
StateDirectory=omi-collector
StateDirectoryMode=0750
PrivateTmp=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
